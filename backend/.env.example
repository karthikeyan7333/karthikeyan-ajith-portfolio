# Render sets PORT automatically. Set FRONTEND_URL to your deployed static site URL.
PORT=5000
FRONTEND_URL=http://localhost:5173

# Optional MongoDB Atlas connection. Without it, contacts are saved to data/contacts.json.
MONGODB_URI=

# Optional SMTP configuration for contact form notifications.
SMTP_HOST=
SMTP_PORT=
EMAIL_USER=
EMAIL_PASS=
CONTACT_RECEIVER_EMAIL=karthikeyankesu4@gmail.com
